# Copy to .env.local and fill in from `npx supabase status` (local stack).
# EXPO_PUBLIC_ values are bundled into the app: only the public anon key belongs here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Test-only, local stack only. Never prefix with EXPO_PUBLIC_ and never commit a real value.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
